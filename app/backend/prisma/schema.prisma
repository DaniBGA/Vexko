generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------
// Multi-business schema
// ----------------------

model Customer {
  id        String    @id @default(cuid())
  name      String    @unique
  plan      String    @default("BASE")
  email     String?   @unique
  phone     String?
  address   String?
  kiosks    Kiosk[]
  products  Product[]
  categories Category[]
  // Suscripción mensual a VEXKO (ver backend/lib/subscription.js). El ciclo
  // arranca en el último pago (o en subscriptionStartedAt si todavía no hay
  // pagos): vence al mes, tiene 10 días de gracia con aviso y después se
  // inhabilita la app para todas las sucursales del cliente.
  subscriptionStartedAt DateTime @default(now())
  // Denormalizado de SubscriptionPayment (el paidAt más reciente) para no
  // consultar los pagos en cada request autenticada.
  lastPaymentAt         DateTime?
  // Cuentas que no se cobran (demo, internas): nunca se avisa ni se bloquea.
  subscriptionExempt    Boolean  @default(false)
  subscriptionPayments  SubscriptionPayment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Un pago de la cuota mensual, registrado a mano desde el panel admin.
model SubscriptionPayment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paidAt     DateTime
  amount     Float?
  note       String?
  createdAt  DateTime @default(now())

  @@index([customerId, paidAt])
}

// Configuración global de VEXKO que se edita desde el panel admin (una sola
// fila, id "global"). Es pública a propósito (GET /api/public/settings): la
// usan la landing (precios) y la pantalla de suscripción vencida (WhatsApp).
model AppSettings {
  id              String   @id @default("global")
  // Solo dígitos, con código de país (ej. 5492494000000), listo para wa.me.
  whatsappNumber  String?
  // Precio mensual de cada plan, en pesos. null = "Próximamente" en la landing.
  priceBase       Float?
  priceIntermedio Float?
  pricePremium    Float?
  updatedAt       DateTime @updatedAt
}

model Kiosk {
  id          String        @id @default(cuid())
  name        String
  address     String?
  phone       String?
  active      Boolean       @default(false)
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user        User?         @relation("KioskAccount")
  clients     Client[]
  invoices    Invoice[]
  kioskProducts KioskProduct[]
  sales       Sale[]
  suppliers   Supplier[]
  cashFlows   CashFlow[]
  employees   Employee[]
  loyaltyRules LoyaltyRule[]
  clientDebts ClientDebt[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([customerId, name])
  @@index([customerId])
}

// customerId null = categoría global/compartida (la que arma el catálogo
// global de productos, común a todos los clientes). Una categoría con
// customerId es propia de ESE cliente y no la ve ningún otro — antes esto
// era una única lista global sin dueño, así que cualquier cliente que creara
// una categoría nueva la veían todos los demás.
model Category {
  id          String       @id @default(cuid())
  name        String
  description String?
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subcategories Subcategory[]
  products    Product[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([customerId, name])
  @@index([name])
  @@index([customerId])
}

model Subcategory {
  id         String     @id @default(cuid())
  name       String
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id])
  products   Product[]

  @@unique([name, categoryId])
  @@index([categoryId])
}

model Product {
  id           String       @id @default(cuid())
  name         String
  description  String?
  barcode      String?      @unique
  sku          String?      @unique
  loadMode     String       @default("pack")
  basePrice    Float?
  baseCost     Float?
  packPrice    Float?
  packUnits    Int?
  packCount    Int?
  categoryId   String?
  subcategoryId String?
  category     Category?    @relation(fields: [categoryId], references: [id])
  subcategory  Subcategory? @relation(fields: [subcategoryId], references: [id])
  isCustom     Boolean      @default(false)
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // compatibility fields (legacy app expects stock/minStock on Product)
  stock        Int?         @default(0)
  minStock     Int?         @default(0)
  salePrice    Float?
  costPrice    Float?
  expiresAt    DateTime?
  supplierId   String?
  supplier     Supplier?    @relation(fields: [supplierId], references: [id])
  active       Boolean      @default(true)

  kioskProducts KioskProduct[]
  saleItems     SaleItem[]
  supplierProducts SupplierProduct[]
  purchaseItems PurchaseItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([categoryId])
  @@index([customerId])
  @@index([isCustom])
  @@index([active, isCustom])
  @@index([name])
}

model KioskProduct {
  id             String   @id @default(cuid())
  kioskId        String
  productId      String
  stock          Int      @default(0)
  minStock       Int      @default(0)
  price          Float?
  cost           Float?
  barcodePrinted Boolean  @default(false)
  kiosk          Kiosk    @relation(fields: [kioskId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([kioskId, productId])
  @@index([kioskId])
  @@index([productId])
}

model Sale {
  id            String     @id @default(cuid())
  date          DateTime   @default(now())
  total         Float
  paymentMethod String
  cashAmount    Float?
  transferAmount Float?
  cardAmount    Float?
  cashReceived  Float?
  changeGiven   Float?
  pointsEarned  Int      @default(0)
  discountAmount Float?
  redemptionId  String?    @unique
  redemption    PointRedemption? @relation(fields: [redemptionId], references: [id])
  kioskId       String
  kiosk         Kiosk      @relation(fields: [kioskId], references: [id])
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  clientId      String?
  client        Client?    @relation("ClientSales", fields: [clientId], references: [id])
  items         SaleItem[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([kioskId])
  @@index([userId])
  @@index([date])
  @@index([createdAt])
  @@index([kioskId, createdAt])
  @@index([userId, createdAt])
  @@index([paymentMethod, createdAt])
}

model SaleItem {
  id         String   @id @default(cuid())
  quantity   Int
  unitPrice  Float
  // Costo unitario al momento de la venta (KioskProduct.cost ?? Product.costPrice).
  // Antes los reportes calculaban el costo de lo vendido con el costPrice
  // ACTUAL del Product global — que en el catálogo global es null — así que
  // la ganancia bruta daba igual a la facturación, y además cambiar el costo
  // de un producto reescribía la ganancia de meses ya cerrados.
  unitCost   Float?
  subtotal   Float
  saleId     String
  productId  String
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())

  @@index([saleId])
  @@index([productId])
  @@index([saleId, productId])
}

// El nombre es único por sucursal, no global: antes era @unique a nivel de
// toda la base, así que si un negocio ya tenía "Arcor" cargado, ningún otro
// cliente podía crear un proveedor con ese nombre (fallaba con "ya existe").
model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  kioskId   String?
  kiosk     Kiosk?   @relation(fields: [kioskId], references: [id])
  products  SupplierProduct[]
  purchases Purchase[]
  items     Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kioskId, name])
  @@index([kioskId])
}

model SupplierProduct {
  id         String   @id @default(cuid())
  cost       Float?
  leadDays   Int?
  supplierId String
  productId  String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
}

model CashFlow {
  id        String   @id @default(cuid())
  type      String
  amount    Float
  description String?
  category  String?
  // false = se pagó por fuera de la caja (transferencia, débito...): cuenta como
  // gasto en los reportes, pero no se resta del efectivo esperado del arqueo.
  paidFromCash Boolean @default(true)
  kioskId   String
  kiosk     Kiosk    @relation(fields: [kioskId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kioskId])
  @@index([type])
  @@index([category])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([kioskId, createdAt])
}

// ----------------------
// App-specific models (auth, clients, invoices, loyalty)
// ----------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  active       Boolean  @default(true)
  kioskId      String?  @unique
  kiosk        Kiosk?   @relation("KioskAccount", fields: [kioskId], references: [id], onDelete: SetNull)
  sales        Sale[]
  cashRegisters CashRegister[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id          String   @id @default(cuid())
  kioskId     String
  name        String
  phone       String
  points      Int      @default(0)
  totalSpent  Float    @default(0)
  kiosk       Kiosk    @relation(fields: [kioskId], references: [id], onDelete: Cascade)
  sales       Sale[]   @relation("ClientSales")
  redemptions PointRedemption[]
  debts       ClientDebt[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kioskId, phone])
  @@index([kioskId])
}

// Fiado: un cliente se lleva mercadería y queda debiendo. Cada deuda es su
// propia fila (no un único saldo acumulado en Client) para poder mostrar el
// historial y permitir pagos parciales contra una deuda puntual en vez de
// un pozo común.
model ClientDebt {
  id          String   @id @default(cuid())
  clientId    String
  kioskId     String
  amount      Float
  paidAmount  Float    @default(0)
  status      String   @default("PENDING") // PENDING | PARTIAL | PAID
  note        String?
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kiosk       Kiosk    @relation(fields: [kioskId], references: [id], onDelete: Cascade)
  payments    ClientDebtPayment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([kioskId])
  @@index([kioskId, status])
}

model ClientDebtPayment {
  id        String     @id @default(cuid())
  debtId    String
  amount    Float
  debt      ClientDebt @relation(fields: [debtId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([debtId])
}

// La regla de fidelización es por sucursal: antes era una única fila global
// (id fijo en 1) compartida por todos los clientes/sucursales del sistema,
// así que cambiarla desde un kiosco cambiaba los puntos de TODOS los demás.
model LoyaltyRule {
  id                String   @id @default(cuid())
  kioskId           String
  kiosk             Kiosk    @relation(fields: [kioskId], references: [id], onDelete: Cascade)
  amountPerPoint    Float
  pointsForDiscount Int
  discountPercent   Float
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([kioskId])
}

// Canjear puntos ya no descuenta el saldo del cliente al toque: genera un
// código (numérico + código de barra) en estado PENDING que el cliente
// presenta en su próxima compra. Al registrar esa venta, el cajero carga el
// código y recién ahí se marca USED y se aplica el descuento al total —
// así el código funciona como un cupón real, no como un descuento invisible
// que se aplicaba solo.
model PointRedemption {
  id         String    @id @default(cuid())
  clientId   String
  pointsUsed Int
  discount   Float
  code       String    @unique
  status     String    @default("PENDING") // PENDING | USED
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sale       Sale?

  @@index([clientId])
}

model Invoice {
  id            String   @id @default(cuid())
  kioskId       String
  saleId        String?
  invoiceType   String
  invoiceNumber String
  total         Float
  status        String
  createdAt     DateTime @default(now())
  kiosk         Kiosk    @relation(fields: [kioskId], references: [id], onDelete: Cascade)

  @@index([kioskId])
  @@index([kioskId, createdAt])
  @@index([saleId])
  @@index([createdAt])
}

model Purchase {
  id         String   @id @default(cuid())
  supplierId String
  status     String   @default("PENDING")
  paymentMethod String @default("CASH")
  deliveryDate DateTime?
  notes      String?
  totalAmount Float   @default(0)
  receivedAt DateTime?
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  items      PurchaseItem[]

  @@index([supplierId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  unitCost   Float
  lineTotal  Float
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())

  @@index([purchaseId])
  @@index([productId])
}

model CashRegister {
  id             String   @id @default(cuid())
  userId         String
  status         String   @default("OPEN")
  openingAmount  Float
  expectedAmount Float?
  actualAmount   Float?
  difference     Float?
  notes          String?
  openedAt       DateTime @default(now())
  closedAt       DateTime?
  user           User     @relation(fields: [userId], references: [id])
  employeeId     String?
  employee       Employee? @relation(fields: [employeeId], references: [id])

  @@index([status])
  @@index([openedAt])
  @@index([userId])
  @@index([employeeId])
}

// Empleado de una sucursal: no tiene cuenta propia en el sistema, solo una
// clave numérica que el dueño le genera para poder abrir la caja e
// identificar quién hizo el turno.
model Employee {
  id            String         @id @default(cuid())
  kioskId       String
  kiosk         Kiosk          @relation(fields: [kioskId], references: [id], onDelete: Cascade)
  name          String
  pinHash       String
  active        Boolean        @default(true)
  cashRegisters CashRegister[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([kioskId])
}
